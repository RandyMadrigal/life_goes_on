# Loaded automatically by `vite build` (mode "production").
# Replace with your real deployed API URL once Railway gives you one.
# If you set VITE_API_URL directly in Vercel's dashboard (Project Settings →
# Environment Variables), that takes precedence over this file at build time —
# you don't have to edit this placeholder if you'd rather manage it there.
VITE_API_URL=https://your-api.up.railway.app
