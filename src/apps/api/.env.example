NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/life-goes-on

# JWT — use long random strings (min 32 chars each)
# Access token: short-lived JWT signed with JWT_ACCESS_SECRET, kept in memory
# on the frontend (never in a cookie/localStorage). Refresh token: opaque
# random value in an httpOnly cookie, rotated on every use — it isn't a JWT,
# so JWT_REFRESH_SECRET is unused (kept for a possible future use).
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=change-me-cookie-secret-min-32-characters-long

# Resend (resend.com) — sends mail over HTTPS instead of raw SMTP, which some
# hosts (e.g. Railway) block outbound. Setup: create a Resend account, add
# and verify your sending domain (dashboard → Domains → the DNS records they
# give you), then create an API key (dashboard → API Keys).
# FROM_EMAIL's domain must match a domain verified in Resend.
RESEND_API_KEY=re_your_api_key
FROM_EMAIL=noreply@dailyinochi.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# API's own public URL (used to build the unsubscribe link sent in emails)
API_BASE_URL=http://localhost:3001

# Bcrypt
BCRYPT_ROUNDS=12

# Admin — single admin user
# Generate the hash with: npm run hash-password -- "your-plain-text-password"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD_HASH=$2b$12$change.me.replace.with.output.of.npm.run.hash-password

# External cron trigger (cron-job.org) — POST to /api/v1/internal/jobs/send-daily-emails
# with header "X-Cron-Secret: <this value>". Use a long random string.
CRON_SECRET=change-me-cron-secret-min-32-characters-long
