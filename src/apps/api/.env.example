NODE_ENV=development
PORT=3001

# MongoDB
MONGODB_URI=mongodb://localhost:27017/life-goes-on

# JWT — use long random strings (min 32 chars each)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Cookies
COOKIE_SECRET=change-me-cookie-secret-min-32-characters-long

# SendGrid — create a key at https://app.sendgrid.com/settings/api_keys
# FROM_EMAIL must be a verified Single Sender or Domain in SendGrid
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=you@your-verified-domain.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# API's own public URL (used to build the unsubscribe link sent in emails)
API_BASE_URL=http://localhost:3001

# Bcrypt
BCRYPT_ROUNDS=12

# Admin — single admin user
# Generate the hash with: npm run hash-password -- "your-plain-text-password"
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD_HASH=$2b$12$change.me.replace.with.output.of.npm.run.hash-password
